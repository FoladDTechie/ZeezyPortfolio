# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# turbopack / next cache
.turbo/

# Claude Code local state (per-machine, regenerated on demand).
# .claude/skills/ stays tracked: skills-lock.json only pins one of the three,
# so the other two exist nowhere else.
.claude/settings.local.json
.claude/*.lock
.claude/history/
.claude/todos/
.claude/projects/
.claude/shell-snapshots/
.claude/statsig/
.claude/ide/
