# Repo-wide ignores. Build and dependency artifacts for the Next app live in
# portfolio/.gitignore.

# OS cruft
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# Editors
*.swp
*.swo
*~
.idea/
*.sublime-workspace

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment
.env
.env.*
!.env.example

# Claude Code local state (per-machine, regenerated on demand).
# Note: .claude/skills/ is intentionally NOT ignored here, so the project
# skills stay reproducible for anyone cloning the repo.
.claude/settings.local.json
.claude/*.lock
.claude/history/
.claude/todos/
.claude/projects/
.claude/shell-snapshots/
.claude/statsig/
.claude/ide/

# Agent scratch
.agents/**/tmp/
